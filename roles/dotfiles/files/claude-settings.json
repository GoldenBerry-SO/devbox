{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(ls:*)",
      "Bash(rg:*)",
      "Bash(fd:*)",
      "Bash(cat:*)",
      "Bash(docker ps:*)",
      "Bash(docker compose ps:*)",
      "Bash(kubectl get:*)",
      "Bash(kubectl describe:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(glab mr view:*)",
      "Bash(npm test:*)",
      "Bash(npm run lint:*)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "ccstatusline",
    "padding": 0
  }
}

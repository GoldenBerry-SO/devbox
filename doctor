#!/usr/bin/env bash
# devbox doctor — SSH in and report what's installed + what needs your auth.
set -euo pipefail
cd "$(dirname "$0")"
ALIAS=$(grep -E '^\s*ssh_host_alias:' config.yml group_vars/all.yml 2>/dev/null | head -1 | awk '{print $2}')
ALIAS=${ALIAS:-devbox}
echo "== doctor: ssh $ALIAS =="
ssh "$ALIAS" 'bash -s' <<'REMOTE'
echo "host: $(hostname)   uptime: $(uptime -p)"
echo "--- toolchain ---"
for t in zsh nvim tmux docker node npm bun uv herdr claude codex gh glab git rg fd bat eza fzf starship kubectl helm k9s psql redis-cli mkcert; do
  printf "  %-10s %s\n" "$t" "$(command -v "$t" >/dev/null 2>&1 && "$t" --version 2>/dev/null | head -1 | cut -c1-42 || echo MISSING)"
done
echo "--- your personal auth (nothing is shared) ---"
gh auth status >/dev/null 2>&1 && echo "  gh: logged in" || echo "  gh: run 'gh auth login'"
git config --global user.email >/dev/null 2>&1 && echo "  git: identity set" || echo "  git: set user.name/email"
id -nG | grep -qw docker && echo "  docker: group ok" || echo "  docker: run 'sudo gpasswd -a \$(whoami) docker' then re-login"
[ -d "$HOME/Src" ] && echo "  ~/Src present" || echo "  ~/Src empty"
REMOTE
